    {
      "source_message": {
        "message_id": 309,
        "speaker": "client",
        "text": "The 22Ω resistors on SDA/SCL are only intended to improve signal quality. Because I2C lines are open-drain, releasing them requires the pull-up resistor to charge the cable capacitance back to 3.3V, which may produce a small overshoot or ringing at the transition edge. The resistor provides damping.\n\nWith our 10–20cm cables, this should not really be an issue, and the 2.2kΩ pull-ups will keep the rise time well within spec. You can therefore remove the resistors if they complicate the layout. If they are already placed and do not get in the way, leave them in. Either option is acceptable."
      },
      "supporting_message_ids": [
        300,
        301
      ],
      "event_type": "MODIFY",
      "value_updates": {
        "interboard_cable_length": {
          "minimum_cm": 10,
          "maximum_cm": 20
        },
        "series_resistor_resistance_ohms": 22,
        "series_resistor_population_policy": "OPTIONAL"
      },
      "value_removals": null,
      "scope_updates": null,
      "ambiguity": null,
      "execution": null
    },
    {
      "source_message": {
        "message_id": 311,
        "speaker": "client",
        "text": "Yes, that is correct. I will send the new document soon; thank you for catching it."
