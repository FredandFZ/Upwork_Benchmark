# Example override file for local development
# Copy this to docker-compose.override.yml and customize

version: '3.8'

services:
  contracts:
    # Override ports if needed
    ports:
      - "8545:8545"
      - "8546:8546"
    
    # Add custom environment variables
    environment:
      - ANVIL_BLOCK_TIME=1
      - ANVIL_FORK_URL=https://sepolia.base.org
    
    # Custom command
    command: anvil --host 0.0.0.0 --port 8545 --fork-url https://sepolia.base.org

  dev:
    # Add development tools
    environment:
      - NODE_ENV=development
      - DEBUG=*
    
    # Mount additional volumes
    volumes:
      - ./scripts:/app/scripts:ro
      - ./config:/app/config:ro

