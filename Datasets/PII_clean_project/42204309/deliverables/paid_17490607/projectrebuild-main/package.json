{
  "name": "project-rebuild",
  "version": "1.0.0",
  "description": "Project Rebuild - NFT Collection with Referral System and Prize Pools on Base Chain",
  "scripts": {
    "compile": "forge build",
    "test": "forge test",
    "test:verbose": "forge test -vvv",
    "test:coverage": "forge coverage",
    "deploy:base": "forge script contracts/deployments/DeployProjectRebuild.s.sol:DeployProjectRebuild --rpc-url base --broadcast --verify",
    "deploy:base-sepolia": "forge script contracts/deployments/DeployProjectRebuild.s.sol:DeployProjectRebuild --rpc-url base-sepolia --broadcast --verify",
    "deploy:mocks": "forge script contracts/deployments/DeployMocks.s.sol:DeployMocks --rpc-url base-sepolia --broadcast",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "forge fmt",
    "docker:build": "docker build -t project-rebuild:latest .",
    "docker:build:dev": "docker build --target development -t project-rebuild:dev .",
    "docker:setup": "bash scripts/docker-setup.sh",
    "docker:test": "docker-compose run --rm test",
    "docker:compile": "docker-compose run --rm compile",
    "docker:node": "docker-compose up contracts",
    "docker:dev": "docker-compose --profile dev up -d dev",
    "docker:shell": "docker-compose run --rm dev /bin/bash",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "nft",
    "erc721",
    "base",
    "chainlink",
    "aave"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@chainlink/contracts": "^1.0.0"
  }
}

