  "target_task": {
    "source_message_id": 19,
    "speaker": "client",
    "text": "Please make another recording. At the beginning, the translation or delivery of “Ana m efunahụ ego mgbe niile, ọ dị m ka ihe adịghị mma na egwuregwu a!” was a little poor. It is very important that you read this message correctly from the phone, while everything else must be said exactly according to the script."
  },
  "history_pool": {
    "boundary": "STRICTLY_BEFORE_TARGET_MESSAGE",
    "contains_target_message": false,
    "message_count": 18,
    "messages": [
      {
        "message_id": 1,
        "created_ts": null,
        "speaker": "client",
        "text": "I’d like to order one video in Igbo from you. Could we agree on $120 for one video, with delivery next Thursday or Friday? I’ll send you all the information now.",
        "milestone": null
      },
      {
        "message_id": 2,
        "created_ts": null,
        "speaker": "client",
        "text": "",
        "milestone": null
      },
      {
        "message_id": 3,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "Good evening to you.",
        "milestone": null
      },
      {
        "message_id": 4,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "Delivery can be completed next Friday. The price for one video is \\$165.",
        "milestone": null
      },
      {
        "message_id": 5,
        "created_ts": null,
        "speaker": "client",
        "text": "Okay, I'll create the offer.",
        "milestone": null
      },
      {
        "message_id": 6,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "Yes",
        "milestone": null
      },
      {
        "message_id": 7,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "Please preview the attached copy. If you approve it, I’ll send the high-resolution version without the watermark.",
        "milestone": null
      },
      {
        "message_id": 8,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "",
        "milestone": null
      },
      {
        "message_id": 9,
        "created_ts": null,
        "speaker": "client",
        "text": "Thank you. I’ve sent it for verification, and I’ll write back once that process is complete. Hello)",
        "milestone": null
      },
      {
        "message_id": 10,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "Alright",
        "milestone": null
      },
      {
        "message_id": 11,
        "created_ts": null,
        "speaker": "client",
        "text": "Because the sentence was delivered a little out of context, please make another recording and say it this way: Ana m efunahụ ego mgbe niile, ọ dị m ka ihe adịghị mma na egwuregwu a",
        "milestone": null
      },
      {
        "message_id": 12,
        "created_ts": null,
        "speaker": "client",
        "text": "Please re-record the introduction because the previous version included something outside the supplied text. The required wording is:\n\"One person wrote to me, такое сообщение\" (starts to read the сообщение с телефон):\n\"I'm constantly losing, it seems to me that something is wrong with the game\"\nAna m efunahụ ego mgbe niile, ọ dị m ka ihe adịghị mma na egwuregwu a",
        "milestone": null
      },
      {
        "message_id": 13,
        "created_ts": null,
        "speaker": "client",
        "text": "Would it be possible to move it to next Friday?",
        "milestone": null
      },
      {
        "message_id": 14,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "Hello",
        "milestone": null
      },
      {
        "message_id": 15,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "Yes",
        "milestone": null
      },
      {
        "message_id": 16,
        "created_ts": null,
        "speaker": "client",
        "text": "Is the video ready now? Please let me know. Hello)",
        "milestone": null
      },
      {
        "message_id": 17,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "I’ll send it to you shortly.",
        "milestone": null
      },
      {
        "message_id": 18,
        "created_ts": null,
