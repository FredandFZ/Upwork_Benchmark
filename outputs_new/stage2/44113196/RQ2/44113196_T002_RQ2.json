      {
        "message_id": 16,
        "created_ts": null,
        "speaker": "client",
        "text": "Is the video ready now? Please let me know. Hello)",
        "milestone": null
      },
      {
        "message_id": 17,
        "created_ts": null,
        "speaker": "freelancer",
        "text": "I’ll send it to you shortly.",
        "milestone": null
