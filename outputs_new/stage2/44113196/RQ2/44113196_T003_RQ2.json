      {
        "message_id": 46,
        "created_ts": null,
        "speaker": "client",
        "text": "Unfortunately, the video once again does not follow the script text. Since there is no time left for another reshoot and the video was not executed correctly, may I cancel this contract, please?",
        "milestone": null
