    "acceptance_criteria": [
      {
        "criterion_id": "AC001",
        "scope": "TARGET_BEHAVIOR",
        "statement": "The built DOCX defines one paragraph style whose displayed name is exactly 'caption text'; the style specifies Century Gothic, italic, 11 pt text with 15 pt line spacing.",
        "observables": [
          {
            "observable_id": "OBS001",
            "type": "ARTIFACT",
            "surface": "dist/template.docx!/word/styles.xml",
            "setup": [
              "Build dist/template.docx in a fresh network-disabled workspace."
            ],
            "actions": [
              {
                "operation": "PARSE_ARTIFACT",
                "target": "dist/template.docx",
                "parameters": {
                  "parts": [
                    "word/styles.xml"
                  ],
                  "namespace": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
                }
              }
            ],
            "expected_observations": [
              {
                "subject": "paragraph styles with normalized w:name/@w:val equal to 'caption text'",
                "operator": "COUNT_EQUALS",
                "expected": 1
              },
              {
                "subject": "caption text effective run font",
                "operator": "EQUALS",
                "expected": "Century Gothic"
              },
              {
                "subject": "caption text effective italic flag",
                "operator": "EQUALS",
                "expected": true
              },
              {
                "subject": "caption text effective size in half-points",
                "operator": "EQUALS",
                "expected": 22
              },
              {
                "subject": "caption text effective line spacing in twentieths of a point",
                "operator": "EQUALS",
                "expected": 300
              }
            ],
            "determinism_controls": [
              "Use namespace-aware XML parsing and resolve basedOn inheritance before comparing effective properties.",
              "Match the displayed style name exactly after XML entity decoding; do not inspect source-code literals."
            ]
          }
        ],
        "negative_cases": [
          {
            "case_id": "NC001",
            "setup": [
              "A DOCX contains the text 'caption text' only in a body paragraph."
            ],
            "action": "Parse word/styles.xml and resolve paragraph styles.",
            "expected_failure_or_absence": "The criterion fails because no paragraph style has that displayed name."
          },
          {
            "case_id": "NC002",
            "setup": [
              "A style named 'caption text' exists but uses default typography."
            ],
            "action": "Resolve its effective run and paragraph properties.",
            "expected_failure_or_absence": "The criterion fails on font, italic, size, or line spacing."
          }
        ]
      },
      {
        "criterion_id": "AC002",
        "scope": "TARGET_BEHAVIOR",
        "statement": "Image-label and table-label paragraphs in the built DOCX both reference the paragraph style whose displayed name is 'caption text'.",
        "observables": [
          {
            "observable_id": "OBS002",
            "type": "ARTIFACT",
            "surface": "dist/template.docx!/word/document.xml",
            "setup": [
              "Build the frozen image-caption and table-caption fixture into dist/template.docx."
            ],
            "actions": [
              {
                "operation": "PARSE_ARTIFACT",
                "target": "dist/template.docx",
                "parameters": {
                  "parts": [
                    "word/document.xml",
                    "word/styles.xml"
                  ],
                  "fixtures": [
                    "image_label",
                    "table_label"
                  ]
                }
              }
            ],
            "expected_observations": [
              {
                "subject": "image-label fixture effective paragraph style name",
                "operator": "EQUALS",
                "expected": "caption text"
              },
              {
                "subject": "table-label fixture effective paragraph style name",
                "operator": "EQUALS",
                "expected": "caption text"
              }
            ],
            "determinism_controls": [
              "Identify fixture paragraphs by frozen semantic bookmarks/content-control tags rather than paragraph order.",
              "Resolve w:pStyle IDs through word/styles.xml before comparing displayed names."
            ]
          }
        ],
        "negative_cases": [
          {
            "case_id": "NC003",
            "setup": [
              "The caption style exists but neither caption fixture references it."
            ],
            "action": "Resolve effective paragraph styles for both fixtures.",
            "expected_failure_or_absence": "The criterion fails; an unused style declaration is insufficient."
          }
        ]
      }
