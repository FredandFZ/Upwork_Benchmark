        "criterion_id": "AC001",
        "scope": "TARGET_BEHAVIOR",
        "statement": "The Android platform build contains exactly the frozen 77-language Google Play locale set with one resource entry per locale.",
        "observables": [
          {
            "observable_id": "OBS001",
            "type": "ARTIFACT",
            "surface": "Android platform build metadata and locale resource index",
            "setup": [
              "Extract a fresh copy of the frozen pre-repo and build it with the repository command."
            ],
            "actions": [
              {
                "operation": "PARSE_ARTIFACT",
                "target": "Android locale resource index",
                "parameters": {}
              }
            ],
            "expected_observations": [
              {
                "subject": "unique Android locale count",
                "operator": "COUNT_EQUALS",
                "expected": 77
              },
              {
                "subject": "Android locale set",
                "operator": "EQUALS",
                "expected": "frozen Google Play 77-language fixture"
              },
              {
                "subject": "missing or duplicate locale resources",
                "operator": "COUNT_EQUALS",
                "expected": 0
              }
            ],
            "determinism_controls": [
              "Use a frozen target-era Google Play language fixture.",
              "Sort and normalize locale tags before set comparison."
            ]
          }
        ],
        "negative_cases": []
      },
      {
