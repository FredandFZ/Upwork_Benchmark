        "scope": "TARGET_BEHAVIOR",
        "statement": "Every declared Android locale can be selected through the public app interaction and yields a valid direction.",
        "observables": [
          {
            "observable_id": "OBS002",
            "type": "FUNCTION",
            "surface": "CurrentMobileService.set_locale",
            "setup": [
              "Extract a fresh copy of the frozen pre-repo and build it with the repository command."
            ],
            "actions": [
              {
                "operation": "CALL_FUNCTION",
                "target": "set_locale",
                "parameters": {
                  "for_each": "Android locale resource index"
                }
              }
            ],
            "expected_observations": [
              {
                "subject": "returned locale for every call",
                "operator": "EQUALS",
                "expected": "normalized requested locale"
              },
              {
                "subject": "returned direction for every call",
                "operator": "MATCHES_REGEX",
                "expected": "^(ltr|rtl)$"
              },
              {
                "subject": "failed locale selections",
                "operator": "COUNT_EQUALS",
                "expected": 0
              }
            ],
            "determinism_controls": [
              "Use the locale index produced by the same candidate build.",
              "Reset service state between locale cases."
            ]
          }
        ],
        "negative_cases": []
