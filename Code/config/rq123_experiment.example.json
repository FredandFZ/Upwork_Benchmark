{
  "schema_version": "rq123-experiment-config-v1",
  "experiment_id": "replace-with-an-immutable-experiment-id",
  "repetitions": 1,
  "agent": {
    "provider": "command",
    "runtime_version": "replace-with-exact-agent-runtime-version",
    "model": "replace-with-agent-model",
    "model_version": "replace-with-exact-version",
    "reasoning_effort": "replace-with-fixed-effort",
    "tool_policy": "NO_REPOSITORY_NO_EXTERNAL_TOOLS",
    "command": [
      "replace-with-agent-executable",
      "replace-with-stateless-subcommand"
    ],
    "output_mode": "stdout_json",
    "output_filename": "agent_response.json",
    "timeout_seconds": 900,
    "environment_allowlist": []
  },
  "judge": {
    "provider": "upwork_stage1",
    "api_interface_version": "stage1-chat-completions-v1",
    "model": "replace-with-judge-model",
    "model_version": "replace-with-exact-version",
    "reasoning_effort": "high",
    "max_concurrent_requests": 4,
    "retries": 3,
    "timeout_seconds": 900
  }
}
