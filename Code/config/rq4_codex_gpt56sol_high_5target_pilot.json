{
  "schema_version": "rq123-experiment-config-v1",
  "experiment_id": "rq4-codex-gpt56sol-high-5target-pilot",
  "repetitions": 1,
  "agent": {
    "provider": "codex_cli",
    "runtime_version": "codex-cli 0.155.1",
    "model": "gpt-5.6-sol",
    "model_version": "gpt-5.6-sol",
    "reasoning_effort": "high",
    "tool_policy": "READ_ONLY_NO_REPOSITORY_NO_EXTERNAL_TOOLS",
    "command": [
      "codex.cmd",
      "exec",
      "--ephemeral",
      "--ignore-user-config",
      "--ignore-rules",
      "--skip-git-repo-check",
      "--sandbox",
      "read-only",
      "--model",
      "{model_version}",
      "-c",
      "model_reasoning_effort=\"{reasoning_effort}\"",
      "--output-last-message",
      "agent_response.json",
      "--json",
      "-"
    ],
    "output_mode": "workspace_file",
    "output_filename": "agent_response.json",
    "timeout_seconds": 900,
    "environment_allowlist": [
      "APPDATA",
      "CODEX_HOME",
      "HOMEDRIVE",
      "HOMEPATH",
      "LOCALAPPDATA",
      "USERPROFILE"
    ]
  },
  "phase_b_agent": {
    "provider": "codex_cli",
    "runtime_version": "codex-cli 0.155.1",
    "model": "gpt-5.6-sol",
    "model_version": "gpt-5.6-sol",
    "reasoning_effort": "high",
    "tool_policy": "LOCAL_REPOSITORY_WRITE_NO_NETWORK",
    "command": [
      "codex.cmd",
      "exec",
      "--ephemeral",
      "--ignore-user-config",
      "--ignore-rules",
      "--skip-git-repo-check",
      "--sandbox",
      "workspace-write",
      "--model",
      "{model_version}",
      "-c",
      "model_reasoning_effort=\"{reasoning_effort}\"",
      "--output-last-message",
      "phase_b_agent_summary.txt",
      "--json",
      "-"
    ],
    "output_mode": "workspace_file",
    "output_filename": "phase_b_agent_summary.txt",
    "timeout_seconds": 1800,
    "environment_allowlist": [
      "APPDATA",
      "CODEX_HOME",
      "HOMEDRIVE",
      "HOMEPATH",
      "LOCALAPPDATA",
      "USERPROFILE"
    ]
  },
  "rq4_judge_agent": {
    "provider": "codex_cli",
    "runtime_version": "codex-cli 0.155.1",
    "model": "gpt-5.6-sol",
    "model_version": "gpt-5.6-sol",
    "reasoning_effort": "high",
    "tool_policy": "LOCAL_WORKSPACE_WRITE_REPOSITORY_HASH_GUARDED_NO_NETWORK",
    "command": [
      "codex.cmd",
      "exec",
      "--ephemeral",
      "--ignore-user-config",
      "--ignore-rules",
      "--skip-git-repo-check",
      "--approve-for-me",
      "--model",
      "{model_version}",
      "-c",
      "model_reasoning_effort=\"{reasoning_effort}\"",
      "--output-last-message",
      "judge_result.json",
      "--json",
      "-"
    ],
    "output_mode": "workspace_file",
    "output_filename": "judge_result.json",
    "timeout_seconds": 900,
    "environment_allowlist": [
      "APPDATA",
      "CODEX_HOME",
      "HOMEDRIVE",
      "HOMEPATH",
      "LOCALAPPDATA",
      "USERPROFILE"
    ]
  }
}
